{
  "name": "gmk-invoice-desktop",
  "productName": "GMK Invoice",
  "version": "1.0.0",
  "description": "GMK Invoice - powerful innovative services. Desktop app for Windows.",
  "author": "GMK Web Services <info@gmkwebservices.co.za>",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "co.za.gmkwebservices.invoice",
    "productName": "GMK Invoice",
    "copyright": "Copyright (c) GMK Web Services",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GMK Invoice",
      "artifactName": "GMK-Invoice-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "GMK-Invoice-Portable-${version}.${ext}"
    }
  }
}